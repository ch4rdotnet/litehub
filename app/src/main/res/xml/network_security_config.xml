<?xml version="1.0" encoding="utf-8"?>
<!-- home assistant is usually plain http on the lan, or https with a self signed or
     user installed ca, so allow both -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
