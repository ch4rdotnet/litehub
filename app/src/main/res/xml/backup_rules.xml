<?xml version="1.0" encoding="utf-8"?>
<!-- android 11 and older. ha.json holds the home assistant token, settings.json the immich key
     and the pin hash, none of it goes in a backup -->
<full-backup-content>
    <exclude domain="file" path="ha.json" />
    <exclude domain="file" path="settings.json" />
</full-backup-content>
