<?xml version="1.0" encoding="utf-8"?>
<!-- android 12 and later, cloud backup and moving to a new device both leave the secrets behind.
     ha.json holds the home assistant token, settings.json the immich key and the pin hash -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ha.json" />
        <exclude domain="file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ha.json" />
        <exclude domain="file" path="settings.json" />
    </device-transfer>
</data-extraction-rules>
